d:CTX_GRIL a d:ContextCard ;
    d:contextId "CTX_GRIL" ;
    d:title "Grilling: frontier rounds and question format" ;
    d:path "skills/upstream/skills/productivity/grilling/SKILL.md" ;
    d:startLine 1 ;
    d:endLine 30 ;
    d:excerpt "--- name: grilling description: Grill the user relentlessly about a plan, decision, or idea. Use when the user wants to stress-test their thinking, or uses any 'grill' trigger phrases. --- Interview the user relentlessly until you reach a shared understanding. Map this as a **design tree**: every decision branches into the decisions that hang off it. Work th …" ;
    d:stage d:Clarification .

d:CTX_DOMSKILL a d:ContextCard ;
