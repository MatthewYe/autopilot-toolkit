    d:title "Domain modeling: glossary and ADR discipline" ;
    d:path "skills/upstream/skills/engineering/domain-modeling/SKILL.md" ;
    d:startLine 1 ;
    d:endLine 50 ;
    d:excerpt "--- name: domain-modeling description: Build and sharpen a project's domain model. Use when discussing codebase terminology, writing or editing a GLOSSARY.md, or recording or editing an ADR. --- # Domain Modeling Actively build and sharpen the project's domain model as you design. This is the *active* discipline: challenging terms, inventing edge-case scenar …" ;
    d:stage d:Clarification ;
    d:whenDomainDocs "true"^^xsd:boolean .

d:CTX_GLOSSARY a d:ContextCard ;
    d:contextId "CTX_GLOSSARY" ;
    d:title "Repository glossary (canonical vocabulary)" ;
    d:path "GLOSSARY.md" ;
    d:startLine 1 ;
    d:endLine 40 ;
    d:excerpt "# Autopilot Toolkit A skill-pack repo targeting Reasonix, Codex, and Kimi Code. Ships 41 skills — 32 upstream (from mattpocock/skills, tracked in `.skill-lock.json`), 1 vendor (third-party, tracked in `.vendor-lock.json`), plus 8 autopilot (custom, living in `skills/autopilot/`). 35 skills are runtime-agnostic (work on any Agent Skills-compliant agent); 6 au …" ;
    d:stage d:Cross .

d:CTX_DOMAIN a d:ContextCard ;
    d:contextId "CTX_DOMAIN" ;
    d:title "Domain docs configuration" ;
    d:path "docs/agents/domain.md" ;
    d:startLine 1 ;
    d:endLine 35 ;
    d:excerpt "# Domain Docs How the engineering skills should consume this repo's domain documentation when exploring the codebase. ## Before exploring, read these - **`GLOSSARY.md`** at the repo root; if absent, read legacy **`CONTEXT.md`**. - **`docs/adr/`** — read ADRs that touch the area you're about to work in. If any of these files don't exist, **proceed silently**. …" ;
    d:stage d:Clarification ;
    d:stage d:Prd ;
    d:whenDomainDocs "true"^^xsd:boolean .

