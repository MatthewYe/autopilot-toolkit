    d:endLine 33 ;
    d:excerpt "{ \"version\": \"distill.v1\", \"stages\": [ { \"id\": \"intake\", \"executor\": \"runner\", \"skill\": null, \"checkpoint\": \"explicit-text-captured\", \"next_action\": \"capture-text-requirement\" }, { \"id\": \"clarification\", \"executor\": \"skill\", \"skill\": \"grill-with-docs\", \"checkpoint\": \"clarification-complete\", \"next_action\": \"invoke-skill\" }, { \"id\": \"prd\", \"executor\": \"skill\" …" ;
