d:T5 a d:Task ;
    d:taskId "T5" ;
    d:title "Shared run-state substrate" ;
    d:requirement "Extract the duplicated state-directory hygiene and atomic-write substrate from director and distill into one shared crate, removing the drifted atomic-write behaviour while keeping both CLIs working." ;
    d:sourceAnchor "corpus/specs/20-run-state-persistence-substrate.md" ;
