d:T8 a d:Task ;
    d:taskId "T8" ;
    d:title "Expected-set entry resolves its skill files" ;
    d:requirement "Make an Expected-set entry resolve every skill file it owns, root and per-runtime variants, so failure is reported per file; ship it as an expand, migrate, contract sequence." ;
    d:sourceAnchor "https://github.com/MatthewYe/autopilot-toolkit/issues/121" ;
