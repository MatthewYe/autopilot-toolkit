d:T6 a d:Task ;
    d:taskId "T6" ;
    d:title "Scheduled upstream drift check" ;
    d:requirement "Compare the vendored upstream pin with the newest release tag on a weekly schedule, open or update exactly one issue when drift exists, and never sync or merge automatically." ;
    d:sourceAnchor "https://github.com/MatthewYe/autopilot-toolkit/issues/151" ;
    d:asOf "2026-11-06" ;
    d:stage d:Clarification ;
    d:stage d:Prd ;
