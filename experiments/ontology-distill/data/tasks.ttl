d:T7 a d:Task ;
    d:taskId "T7" ;
    d:title "DSH as a first-class skill runtime" ;
    d:requirement "Add DeepSeek Harness as a first-class runtime: DSH variant sources, router selection, variant validation and runtime documentation, without changing the other runtimes." ;
