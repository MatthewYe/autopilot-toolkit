@prefix d: <https://example.org/autopilot/distill#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

# Requirement tasks in the experiment.  Facts are taken from the
# requirement text and the resulting merged artifacts, not from the
# ontology's own conditions.
d:T1 a d:Task ;
    d:taskId "T1" ;
    d:title "Dual-runtime skill compatibility" ;
    d:requirement "Allow one skill asset set to install and run on both Reasonix and Codex, without the two runtime directories polluting each other, while keeping the vendored upstream snapshot trackable." ;
    d:sourceAnchor "corpus/specs/0002-dual-runtime-compatibility.md" ;
    d:asOf "2026-06-30" ;
    d:stage d:Clarification ;
    d:stage d:Prd ;
    d:stage d:Issues ;
    d:changeKind d:NewFeature ;
    d:changeKind d:ContractChange ;
    d:surface d:Skills ;
    d:surface d:Install ;
    d:runtime d:Reasonix ;
    d:runtime d:Codex ;
    d:ambiguity d:Medium ;
    d:multiModule "true"^^xsd:boolean ;
    d:crossRuntime "true"^^xsd:boolean ;
    d:multiSlice "true"^^xsd:boolean ;
    d:domainDocs "true"^^xsd:boolean ;
    d:adr "true"^^xsd:boolean ;
    d:newAdr "true"^^xsd:boolean ;
    d:externalTracker "true"^^xsd:boolean ;
    d:wideRefactor "false"^^xsd:boolean ;
    d:userFacing "true"^^xsd:boolean ;
    d:hasExistingSeam "false"^^xsd:boolean .

d:T2 a d:Task ;
    d:taskId "T2" ;
    d:title "Kimi Code runtime adaptation" ;
    d:requirement "Add Kimi Code as a supported runtime, fix the frontmatter parsing that made skills disappear there, and leave Reasonix and Codex behaviour unchanged." ;
    d:sourceAnchor "corpus/specs/0003-kimi-code-adaptation.md" ;
