d:T3 a d:Task ;
    d:taskId "T3" ;
    d:title "Self-contained tarball install" ;
    d:requirement "Provide a self-contained tarball install: one curl pipe command, skills deployed as real files so the directory is portable across machines, and upgrades that never touch user-owned skills." ;
    d:sourceAnchor "corpus/specs/0004-self-contained-tarball-install.md" ;
    d:asOf "2026-07-24" ;
