d:T4 a d:Task ;
    d:taskId "T4" ;
    d:title "Director write-path convergence" ;
    d:requirement "Make every director-cli state mutation a pure record method behind one commit seam, matching the distill-cli layering, with zero behaviour change." ;
    d:sourceAnchor "corpus/specs/19-director-state-mutation-persistence-split.md" ;
    d:asOf "2026-10-02" ;
